# --- Database (MongoDB Atlas) ---
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/helpdesk?retryWrites=true&w=majority"
MONGODB_URI="mongodb://localhost:27017/helpdesk"
# --- Auth.js ---  generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Public base URL used only in email links; update it if your local app uses another port.
APP_URL="http://localhost:3000"
# Leave AUTH_URL/NEXTAUTH_URL unset in local development so Auth.js uses the active request host and port.

# --- Gmail SMTP --- use a Google "App Password" (needs 2FA), NOT your normal password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your.address@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
MAIL_FROM="Helpdesk <your.address@gmail.com>"

# --- Cloudinary (free plan) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Cron protection (Vercel sends this as a Bearer token automatically) ---
CRON_SECRET=""

# --- Seed script only ---
SEED_PASSWORD="ChangeMe123!"
